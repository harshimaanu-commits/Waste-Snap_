# Copy this file to .env (in the project root) and fill in the values.
# Never commit .env - it is listed in .gitignore.

# Any long random string, e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# MongoDB Atlas connection string (shared by the team)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=wastesnap_db

# true = keep a copy of the database in the data/ folder (JSON files + a .db file)
AUTO_EXPORT=true

# true while developing, false otherwise
FLASK_DEBUG=true

# Speed of the simulated payment demo: 1 = normal, 2 = twice as slow, 0.5 = faster
PAYMENT_SPEED=1
